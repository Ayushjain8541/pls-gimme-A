# Copy to .env.local. Never commit .env.local.
DATA_DIR=.data
DATABASE_PATH=.data/app.sqlite
PYTHON_BIN=.venv/bin/python
OPENAI_API_KEY=
# Use model IDs your API account can access. Ingestion needs image inputs
# and structured outputs. Feedback/chat need structured outputs.
OPENAI_MODEL_INGEST=
OPENAI_MODEL_FEEDBACK=
OPENAI_MODEL_CHAT=
