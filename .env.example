# Copy to .env.local. Never commit .env.local.
DATA_DIR=.data
DATABASE_PATH=.data/app.sqlite
PYTHON_BIN=.venv/bin/python
ANTHROPIC_API_KEY=
# Optional overrides. Haiku is used when a model setting is omitted or empty.
# All roles need image inputs and structured outputs for figure-based questions.
ANTHROPIC_MODEL_INGEST=claude-haiku-5-5
ANTHROPIC_MODEL_FEEDBACK=claude-haiku-5-5
ANTHROPIC_MODEL_CHAT=claude-haiku-5-5
